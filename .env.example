APP_NAME=NEXUS EDU XR
APP_ENV=development
APP_BASE_URL=http://localhost:8000
SESSION_SECRET=replace-with-a-long-random-secret
NEXUS_SESSION_SECRET=replace-with-a-different-long-random-secret
COOKIE_SECURE=false

# Vacío = SQLite local. Render inyecta PostgreSQL mediante DATABASE_URL.
DATABASE_URL=
SQLITE_PATH=data/nexus.db

# Cuenta administrativa inicial. No publique valores reales en GitHub.
# La contraseña debe contener al menos 12 caracteres y se cambia en el primer acceso.
NEXUS_BOOTSTRAP_ADMIN_EMAIL=
NEXUS_BOOTSTRAP_ADMIN_PASSWORD=
NEXUS_BOOTSTRAP_ADMIN_NAME=Administrador NEXUS

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_WORKSPACE_DOMAIN=
